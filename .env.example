# Copy to .env and fill in from https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=your-client-id
# Optional. Leave it out: Studify uses the address it's opened at (e.g. http://127.0.0.1:5173/ or
# https://your-site.netlify.app/). Whatever address you open must be listed under Redirect URIs.
# VITE_SPOTIFY_REDIRECT_URI=
